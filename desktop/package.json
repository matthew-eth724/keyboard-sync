{
  "name": "keyboard-sync-desktop",
  "version": "1.0.0",
  "main": "src/main/main.ts",
  "scripts": {
    "start": "ts-node src/main/main.ts",
    "build": "tsc",
    "package": "electron-builder"
  },
  "dependencies": {
    "electron": "^28.0.0",
    "electron-store": "^8.0.1",
    "@electron/remote": "^2.1.0",
    "express": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "@types/node": "^20.10.6",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.keyboard-sync.desktop",
    "productName": "Keyboard Sync Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**",
      "node_modules/**"
    ],
    "mac": {
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": "portable"
    }
  }
}
